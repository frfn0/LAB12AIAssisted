# Переменные окружения приложения.
# Скопируйте файл в .env и при необходимости измените значения.
# Сам .env не добавляется в git.

# Строка подключения к базе.
# По умолчанию используется локальный файл SQLite, чтобы приложение
# запускалось без внешних сервисов.
DATABASE_URL=sqlite+pysqlite:///./library.db

# Для docker-compose (PostgreSQL из контейнера):
# DATABASE_URL=postgresql+psycopg2://library:library@db:5432/library

# Печатать SQL-запросы в лог. В продакшене оставлять выключенным:
# запросы могут содержать пользовательские данные.
SQL_ECHO=false

# Бизнес-правила предметной области.
LOAN_DAYS=14
FINE_PER_DAY=1.50

# Ключ доступа для POST, PUT и DELETE.
# Пустое значение означает, что проверка выключена: приложение работает
# в режиме разработки и любой может изменять данные.
API_KEY=