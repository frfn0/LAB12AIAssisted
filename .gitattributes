# Текст хранится с LF, чтобы диффы не зависели от настроек core.autocrlf
# и чтобы линтеры не ругались на смешанные переносы строк.
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.log   text eol=lf
*.example text eol=lf

# Бинарные файлы
*.db    binary
*.sqlite binary
*.sqlite3 binary